# Whisper model: tiny.en, base.en, small.en, medium.en, large-v3 (drop ".en" for multilingual)
WHISPER_MODEL=medium.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Language code, or leave empty to auto-detect
WHISPER_LANGUAGE=en

# Hold this key to start recording, press it again to stop (pynput Key name like right_cmd, right_alt, f8, or a single character)
TRIGGER_KEY=right_cmd

# How long to hold the trigger key to start recording (a quicker tap does nothing)
HOLD_TO_START_SECONDS=2.0

# Ignore recordings shorter than this (seconds)
MIN_RECORDING_SECONDS=0.3

# Self-correction layer: uses a local Ollama model to apply spoken corrections
# ("change it to 50 no 60 pixels" -> "change it to 60 pixels")
CORRECTION_ENABLED=true
CORRECTION_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
CORRECTION_TIMEOUT_SECONDS=20
